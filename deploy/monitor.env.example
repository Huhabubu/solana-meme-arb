# 复制到 /etc/solana-meme-arb/monitor.env 后再填写真实值。
# 真实密钥不得提交到 GitHub。
HELIUS_API_KEY=REPLACE_WITH_HELIUS_API_KEY

# 长时研究数据使用固定持久化路径。
OPPORTUNITY_LOG_PATH=/var/lib/solana-meme-arb/opportunities.jsonl

# 单次等待账户更新的上限。超时后 monitor 会按既定重连策略重建 WSS 会话。
OPPORTUNITY_MONITOR_UPDATE_TIMEOUT_SECONDS=45

# 生产常驻模式故意不设置以下两项：
# OPPORTUNITY_MONITOR_UPDATES=
# OPPORTUNITY_MONITOR_MAX_SECONDS=
# 不设置时不会因 update 数或总时长主动退出。

# 生产常驻模式也暂不设置 OPPORTUNITY_MONITOR_MAX_RECONNECTS。
# 不设置表示 monitor 自身持续尝试有界退避重连；若进程因不可恢复错误退出，systemd 再负责拉起。
