[Unit]
Description=Solana Meme Cross-DEX Arbitrage Research Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=solana-arb
Group=solana-arb
WorkingDirectory=/var/lib/solana-meme-arb
EnvironmentFile=/etc/solana-meme-arb/monitor.env
ExecStart=/opt/solana-meme-arb/solana-meme-arb opportunity-monitor
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s

# 研究监控器只需要网络和数据目录写权限；程序与系统配置保持只读。
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/solana-meme-arb

[Install]
WantedBy=multi-user.target
